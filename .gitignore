# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Contract build artifacts.
# `managed/` holds the compiler output (contract JS, circuit keys, zkir) that
# the deploy scripts and tests load at runtime. It is committed deliberately:
# the Level 1 submission asks for the directory to be present and inspectable
# without a local toolchain. Regenerate at any time with `npm run compile`.
contracts/managed/

# Deployment info
deployment.json

# Wallet seed (sensitive)

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Private state
*-state/

# Midnight.js level private-state store, written by deploy/cli/e2e-check next to
# the working directory. Holds the encrypted claim-secret witness — never commit it.
midnight-level-db/

# Temporary files
tmp/
temp/

# WanningGate private witness secret — private input, never share or commit
.wanning-gate-secret

# Midnight network state (per-network seeds, deploy addresses)
.midnight-state.json

# Midnight wallet sync state (per-network serialized wallet state cache)
.midnight-wallet-state/
